<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Source analysis is a wide parallel workload (parse, dispatch index and the per-file
         symbol loop all run on a worker team), but the process defaulted to workstation GC:
         one GC thread behind fourteen allocating workers. On the large trees of issue #65 that
         showed up as CPU collapsing to a single core "while the GC was under pressure" while
         the heap kept climbing; server GC keeps reclamation parallel to allocation. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Platform>x64</Platform>
    <OutputType>Exe</OutputType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <Version>5.0.0</Version>
    <Title>OWASP Dosai</Title>
    <Authors>Team AppThreat &lt;cloud@appthreat.com&gt;</Authors>
    <Description>Dotnet Source and Assembly Inspector (Dosai) is a tool to list details about the namespaces and methods from sources and assemblies.</Description>
    <PackageProjectUrl>https://github.com/owasp-dep-scan/dosai</PackageProjectUrl>
    <PackageLicense>MIT</PackageLicense>
    <RepositoryUrl>https://github.com/owasp-dep-scan/dosai</RepositoryUrl>
    <RepositoryType>GitHub</RepositoryType>
    <PackageTags>roslyn,disassembler,slices,call-graph,data-flow</PackageTags>
    <Company>AppThreat</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.13.101-rc1.26425.128" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Dosai.Tests" />
  </ItemGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="Globalization.globalconfig" />
  </ItemGroup>

  <!-- A self-contained single-file Dosai carries its runtime inside the executable and gives
       Roslyn no framework files to reference (issue #67). FrameworkReferences loads each
       framework assembly from the bundle and references its in-memory metadata; the names come
       from the Microsoft.NETCore.App reference pack this build compiles against, embedded here
       so the list always matches the bundled runtime. The metadata read is the one unsafe call
       (AssemblyExtensions.TryGetRawMetadata hands out a pointer). -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <Target Name="EmbedFrameworkAssemblyNames" AfterTargets="ResolveTargetingPackAssets" BeforeTargets="PrepareResources">
    <ItemGroup>
      <_DosaiFrameworkAssemblyName Include="@(Reference->'%(Filename)')" Condition="'%(Reference.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Error Condition="'@(_DosaiFrameworkAssemblyName)' == ''" Text="No Microsoft.NETCore.App reference assemblies were resolved; FrameworkReferences needs their names for self-contained builds." />
    <WriteLinesToFile File="$(IntermediateOutputPath)framework-assemblies.txt" Lines="@(_DosaiFrameworkAssemblyName->Distinct())" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)framework-assemblies.txt" LogicalName="Dosai.framework-assemblies.txt" />
      <FileWrites Include="$(IntermediateOutputPath)framework-assemblies.txt" />
    </ItemGroup>
  </Target>
</Project>
